{
  "name": "echotype-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "Modern Voice-to-Text Application with AI Integration",
  "author": "ljyou001",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.node.json -w\" \"wait-on tcp:5173 && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json && node -e \"require('fs').renameSync('dist-electron/preload.js', 'dist-electron/preload.cjs')\" && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "package": "npm run build && electron-builder build --config.directories.output=dist-package",
    "dist": "electron-builder",
    "postinstall": "node -e \"if(process.platform==='darwin') { require('child_process').execSync('electron-rebuild -f -w uiohook-napi,@hurdlegroup/robotjs', {stdio:'inherit'}) }\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hurdlegroup/robotjs": "^0.12.3",
    "i18next": "^25.8.0",
    "jimp": "^0.22.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.5.0",
    "uiohook-napi": "^1.5.4",
    "extract-zip": "^2.0.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^31.6.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.8.2",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0",
    "@electron/rebuild": "^3.6.0"
  },
  "build": {
    "appId": "com.echotype.app",
    "productName": "EchoType",
    "copyright": "Copyright © 2026 ljyou001",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*",
      "node_modules/@hurdlegroup/robotjs/**/*"
    ],
    "extraResources": [
      {
        "from": "../models",
        "to": "models"
      },
      {
        "from": "../backend/models_catalog.json",
        "to": "backend/models_catalog.json"
      }
    ],
    "win": {
      "target": [
        "zip",
        "appx"
      ],
      "icon": "assets/icon-white.png",
      "extraResources": [
        {
          "from": "../dist/echotype-backend",
          "to": "backend"
        }
      ]
    },
    "appx": {
      "identityName": "${env.APPX_IDENTITY_NAME}",
      "publisher": "${env.WINDOWS_PUBLISHER_ID}",
      "publisherDisplayName": "${env.APPX_PUBLISHER_DISPLAY_NAME}",
      "applicationId": "EchoType",
      "displayName": "EchoType",
      "languages": [
        "en-US",
        "zh-CN"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon-white.png",
      "extraResources": [
        {
          "from": "../dist/echotype-backend",
          "to": "backend"
        }
      ]
    }
  }
}
