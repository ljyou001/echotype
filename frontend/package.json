{
  "name": "echotype-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "Modern Voice-to-Text Application with AI Integration",
  "author": "ljyou001",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.node.json -w\" \"wait-on tcp:5173 && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json && node -e \"require('fs').renameSync('dist-electron/preload.js', 'dist-electron/preload.cjs')\" && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "ico-to-png": "node scripts/ico-to-png.cjs",
    "package": "npm run build && electron-builder build --config.directories.output=dist-package",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hurdlegroup/robotjs": "^0.12.3",
    "i18next": "^25.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.5.0",
    "sharp": "^0.34.5",
    "uiohook-napi": "^1.5.4",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^31.6.0",
    "electron-builder": "^24.13.3",
    "sharp-ico": "^0.1.5",
    "typescript": "^5.8.2",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.echotype.app",
    "productName": "EchoType",
    "copyright": "Copyright © 2026 ljyou001",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/echotype-backend.exe",
        "to": "backend/echotype-backend.exe"
      },
      {
        "from": "../models",
        "to": "models"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png"
    }
  }
}