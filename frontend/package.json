{
  "name": "echotype-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "Modern Voice-to-Text Application with AI Integration",
  "author": "ljyou001",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.node.json -w --preserveWatchOutput\" \"npm:build:preload -- --watch=forever\" \"wait-on tcp:5173 dist-electron/main.js dist-electron/preload.cjs && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .\"",
    "dev:mock": "cross-env ECHOTYPE_ENGINE=mock npm run dev",
    "build:core": "tsc -p tsconfig.node.json && npm run build:preload",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --sourcemap --outfile=dist-electron/preload.cjs --log-level=warning",
    "build": "npm run build:core && vite build",
    "typecheck:core": "tsc -p tsconfig.test.json",
    "test:core": "vitest run --dir electron",
    "smoke:core": "npm run build:core && cross-env ECHOTYPE_ENGINE=mock ECHOTYPE_SMOKE=1 electron .",
    "preview": "vite preview",
    "start": "electron .",
    "package": "npm run build && electron-builder build --config electron-builder.cjs --config.directories.output=dist-package",
    "dist": "electron-builder --config electron-builder.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "extract-zip": "^2.0.1",
    "i18next": "^25.8.0",
    "jimp": "^0.22.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.5.0",
    "robotjs": "^0.9.1",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.23.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.3.1",
    "electron-builder": "~26.18.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.8.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  }
}
