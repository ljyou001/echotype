  "actions": [
    {
      "id": "cleanup",
      "kind": "transform",
      "group": "cleanup",
      "name": {
        "en": "Clean up",
        "zh": "整理润色"
      },
      "description": {
        "en": "Remove filler words and repeats, fix punctuation.",
        "zh": "去掉口头禅和重复，修正标点。"
      },
      "icon": "✨",
      "needsProvider": true,
      "fields": [],
      "dictionary": true,
      "prompt": {
        "system": "You clean up dictated speech. Remove filler words, repeated words and false starts, resolve self-corrections (keep the final version), and fix punctuation and capitalization. Keep the original language, meaning and voice. Do not add information. Output only the result, with no preamble or quotes.",
        "user": "{{text}}",
        "maxTokens": 2048
      },
      "confirm": false
    },
    {
      "id": "translate",
