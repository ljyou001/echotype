    {
      "id": "webhook",
      "kind": "send",
      "group": "chat",
      "name": {
        "en": "Webhook",
        "zh": "Webhook"
      },
      "description": {
        "en": "POST your text to any URL and show the reply.",
        "zh": "把文字 POST 到任意地址，并显示返回内容。"
      },
      "icon": "🪝",
      "needsProvider": false,
      "fields": [
        {
          "key": "url",
          "type": "secret",
          "label": {
            "en": "Webhook URL",
            "zh": "Webhook 地址"
          },
          "placeholder": "https://…"
        },
        {
          "key": "headers",
          "type": "secret",
          "label": {
            "en": "Headers (optional)",
            "zh": "请求头（可选）"
          },
          "optional": true,
          "placeholder": "Authorization: Bearer …",
          "description": {
            "en": "One per line, like “Authorization: Bearer …”.",
            "zh": "每行一个，如 “Authorization: Bearer …”。"
          }
        },
        {
          "key": "body",
          "type": "textarea",
          "label": {
            "en": "Body template",
            "zh": "请求体模板"
          },
          "default": "{\"text\": {{text|json}}}",
          "description": {
            "en": "{{text|json}} inserts your text as a safe JSON string.",
            "zh": "{{text|json}} 会把文字作为安全的 JSON 字符串插入。"
          }
        },
        {
          "key": "replyPath",
          "type": "text",
          "label": {
            "en": "Reply field (optional)",
            "zh": "回复字段（可选）"
          },
          "optional": true,
          "placeholder": "data.answer",
          "description": {
            "en": "Dot path in the JSON response. Leave empty to detect automatically.",
            "zh": "返回 JSON 里的点路径。留空则自动识别。"
          }
        }
      ],
      "http": {
        "method": "POST",
        "url": "{{url}}",
        "allowHosts": [
          "*"
        ],
        "headersField": "headers",
        "bodyField": "body",
        "replyField": "replyPath"
      },
      "hint": {
        "en": "Works with any service that supports webhooks: n8n, Zapier, Make, Dify, Coze, Feishu, DingTalk, WeCom bots and more. If the webhook replies with text, the reply appears here, so you can use it like a chat.",
        "zh": "任何支持 webhook 的服务都能用：n8n、Zapier、Make、Dify、Coze，飞书、钉钉、企业微信机器人等。如果 webhook 返回文字，回复会显示在这里，可以当对话用。"
      },
      "egress": {
        "hosts": [],
        "local": false,
        "context": []
      },
      "confirm": false,
      "dictionary": false
    },
